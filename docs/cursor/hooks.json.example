{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/repograph-session-start.sh",
        "timeout": 120
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/repograph-session-start.sh",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/repograph-session-reminder.sh",
        "timeout": 30
      }
    ]
  }
}
