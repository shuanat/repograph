{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/repograph-session-start.ps1",
        "timeout": 120
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/repograph-session-start.ps1",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/repograph-session-reminder.ps1",
        "timeout": 30
      }
    ]
  }
}
